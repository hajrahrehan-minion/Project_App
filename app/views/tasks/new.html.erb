<div class="task-form-container">
  <div class="navigation">
    <%= link_to "← Back to #{@project.title}", project_path(@project), class: "btn-back" %>
  </div>

  <h1>New Task for <%= @project.title %></h1>

  <%= form_with(model: [@project, @task], local: true) do |f| %>
    <% if @task.errors.any? %>
      <div class="error-messages">
        <h2><%= pluralize(@task.errors.count, "error") %> prohibited this task from being saved:</h2>
        <ul>
          <% @task.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="form-group">
      <%= f.label :title %>
      <%= f.text_field :title, placeholder: "Enter task title...", autofocus: true, class: "form-input" %>
    </div>

    <div class="form-actions">
      <%= f.submit "Create Task", class: "btn btn-primary" %>
      <%= link_to "Cancel", project_path(@project), class: "btn btn-secondary" %>
    </div>
  <% end %>
</div>